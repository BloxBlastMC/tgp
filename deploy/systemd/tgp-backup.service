# Nightly backup, run by tgp-backup.timer. Keeps 14 days of archives in
# /var/backups/tgp. Copy them off the machine too (rsync, restic, S3...).
#   cp tgp-backup.service tgp-backup.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tgp-backup.timer
#   systemctl start tgp-backup        # run one now
[Unit]
Description=tgp backup
After=tgp-server.service

[Service]
Type=oneshot
User=tgp
Group=tgp
UMask=0077
# /var/backups/tgp, owned by tgp, mode 0700.
StateDirectory=tgp
ReadWritePaths=/var/backups/tgp
ExecStartPre=+/usr/bin/install -d -m 0700 -o tgp -g tgp /var/backups/tgp
ExecStart=/bin/sh -c 'exec /usr/local/bin/tgp-server backup -c /etc/tgp/config.toml --no-caches -o "/var/backups/tgp/tgp-$(date +%%Y%%m%%d-%%H%%M%%S).tar.gz"'
ExecStartPost=/usr/bin/find /var/backups/tgp -name 'tgp-*.tar.gz' -mtime +14 -delete
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
